{
  "$defs": {
    "RankedFinding": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "maximum": 3,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "citations": {
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "rank",
        "label",
        "severity"
      ],
      "title": "RankedFinding",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "Compliance",
        "Info",
        "Low",
        "Medium",
        "High"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StructuredAssessment": {
      "additionalProperties": false,
      "properties": {
        "ranked_findings": {
          "items": {
            "$ref": "#/$defs/RankedFinding"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Ranked Findings",
          "type": "array"
        },
        "decision_summary": {
          "minLength": 1,
          "title": "Decision Summary",
          "type": "string"
        }
      },
      "required": [
        "ranked_findings",
        "decision_summary"
      ],
      "title": "StructuredAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "private_notes": {
      "title": "Private Notes",
      "type": "string"
    },
    "private_plan": {
      "title": "Private Plan",
      "type": "string"
    },
    "public_message": {
      "title": "Public Message",
      "type": "string"
    },
    "assessment": {
      "$ref": "#/$defs/StructuredAssessment"
    }
  },
  "required": [
    "private_notes",
    "private_plan",
    "public_message",
    "assessment"
  ],
  "title": "AgentTurnOutput",
  "type": "object"
}