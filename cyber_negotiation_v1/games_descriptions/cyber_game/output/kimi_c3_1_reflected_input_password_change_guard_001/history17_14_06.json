  "scenario": {
    "scenario_id": "reflected_input_password_change_guard_001",
    "source_family": "web_application",
    "difficulty": "hard",
    "label_set_id": "web_triage_v1",
    "lines": [
      {
        "id": "L001",
        "text": "A web application contains a page where users can provide their name through a URL parameter."
      },
      {
        "id": "L002",
        "text": "The value of the parameter is displayed in the returned HTML page."
      },
      {
        "id": "L003",
        "text": "A tester already observed a XSS reflected vulnerability. He observed that HTML input submitted through this parameter is rendered by the browser when the page loads."
      },
      {
        "id": "L004",
        "text": "For example, the payload `<img src=q onerror=prompt(8)>` results in JavaScript execution when the page is opened."
      },
      {
        "id": "L005",
        "text": "The request URL for this page becomes `/displayname?name=%3Cimg%20src%3Dq%20onerror%3Dprompt%288%29%3E`."
      },
      {
        "id": "L006",
        "text": "When a user opens this link in the browser, the alert dialog appears, indicating that the injected script is executed."
      },
      {
        "id": "L007",
        "text": "A request triggered from the page where the injected script executed includes the header `Referer: http://webapp/displayname`."
      },
      {
        "id": "L008",
        "text": "Another page of the application allows authenticated users to change their password."
      },
      {
        "id": "L009",
        "text": "Changing the password generates a request such as `/changepassword?password_new=newpass&password_conf=newpass&Change=Change`."
      },
      {
        "id": "L010",
        "text": "During code review, the following condition was identified in the password change logic: `if ( stripos($_SERVER['HTTP_REFERER'], $_SERVER['SERVER_NAME']) !== false )`."
      },
      {
        "id": "L011",
        "text": "The developer states that this check ensures that password-change requests originate from pages within the application."
      }
    ],
    "user_assumption": "The tester believes the password change functionality is safe because the integrated referer-based policy in the code ensures requests only originate from within the application. He believes that there is no other vulnerability besides the already known reflected XSS."
  },
